# ── Anthropic ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── AIWorkPay ──────────────────────────────────────────────────────────
# Leave empty to use the built-in mock client (for local development).
AIWORKPAY_API_KEY=
AIWORKPAY_BASE_URL=https://api.aiworkpay.com/v1

# ── Orchestrator tuning ────────────────────────────────────────────────
# Minimum AI confidence score before delegating a task to a human.
CONFIDENCE_THRESHOLD=0.8

# Budget (USD) allocated per human-delegated task.
DEFAULT_TASK_BUDGET=0.10

# Maximum autonomous self-improvement iterations.
MAX_AUTONOMOUS_LOOPS=10

# Claude model to use across all agents.
CLAUDE_MODEL=claude-opus-4-7
